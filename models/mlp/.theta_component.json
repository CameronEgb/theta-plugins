{
  "id": "mlp",
  "name": "Multi-Layer Perceptron (MLP)",
  "kind": "model",
  "version": "1.0.0",
  "description": "Standard Multi-Layer Perceptron neural network architectures for classification, value estimation, and policy modeling.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "paradigms": [
    "online_rl",
    "offline_rl",
    "supervised"
  ],
  "target_path": "src/usr/models/mlp",
  "config_path": "in/config/model/basics/mlp.yaml",
  "config_paths": [
    "in/config/model/basics/mlp.yaml",
    "in/config/model/basics/mlp_classifier.yaml"
  ],
  "suite": "thetalib",
  "hidden": true,
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "in/config/model/basics/mlp.yaml": {
        "type": "object",
        "properties": {
          "hidden_dims": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "activation": {
            "type": "string",
            "enum": [
              "relu",
              "gelu",
              "tanh",
              "elu",
              "silu",
              "sigmoid",
              "leaky_relu",
              "identity"
            ]
          }
        }
      },
      "in/config/model/basics/mlp_classifier.yaml": {
        "type": "object",
        "properties": {
          "hidden_dims": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "activation": {
            "type": "string",
            "enum": [
              "relu",
              "gelu",
              "tanh",
              "elu",
              "silu",
              "sigmoid",
              "leaky_relu",
              "identity"
            ]
          },
          "dropout": {
            "type": "number"
          }
        }
      }
    }
  }
}
