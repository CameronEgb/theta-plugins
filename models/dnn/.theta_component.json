{
  "id": "dnn",
  "name": "Deep Neural Network (MLP)",
  "kind": "model",
  "version": "1.0.0",
  "description": "Standard Multi-Layer Perceptron (DNN) wrapping PyTorch Linear, LayerNorm, and Dueling Q-value heads.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "target_path": "src/usr/models/dnn",
  "config_path": "in/config/model/basics/dnn.yaml",
  "config_paths": [
    "in/config/model/basics/dnn.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "suite": "thetalib",
  "hidden": true,
  "parameter_schema": {
    "type": "object",
    "properties": {
      "hidden_sizes": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "activation": {
        "type": "string",
        "enum": [
          "relu",
          "gelu",
          "tanh",
          "elu",
          "silu",
          "sigmoid",
          "leaky_relu",
          "identity"
        ]
      }
    }
  }
}
