{
  "id": "robotics-mujoco",
  "name": "Gymnasium MuJoCo Robotics",
  "kind": "env",
  "version": "1.0.1",
  "description": "Continuous-control robotics benchmarks from Gymnasium MuJoCo: Ant, HalfCheetah, Hopper, Walker2d, and Humanoid.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "config_paths": [
    "in/config/env/mujoco/ant.yaml",
    "in/config/env/mujoco/half_cheetah.yaml",
    "in/config/env/mujoco/hopper.yaml",
    "in/config/env/mujoco/walker2d.yaml",
    "in/config/env/mujoco/humanoid.yaml"
  ],
  "dependencies": {
    "pip": [
      "gymnasium[mujoco]>=1.0.0"
    ]
  },
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "online_rl"
  ],
  "target_path": "in/envs/mujoco",
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "in/config/env/mujoco/ant.yaml": {
        "type": "object",
        "properties": {
          "monitor_metric": {
            "type": "string"
          },
          "preprocess_on_load": {
            "type": "boolean"
          },
          "env_id": {
            "type": "string"
          },
          "num_envs": {
            "type": "integer"
          },
          "num_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "in/config/env/mujoco/half_cheetah.yaml": {
