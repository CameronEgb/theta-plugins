{
  "id": "pyrenees-env",
  "name": "Pyrenees Hybrid RL Environment Suite",
  "kind": "env",
  "version": "1.0.0",
  "description": "Pyrenees mountain driving benchmarks, valuation logic, symbolic rules, and evaluation interfaces.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "target_path": "in/envs/pyrenees",
  "config_path": "in/config/env/pyrenees.yaml",
  "dependencies": {
    "components": [
      "thetalib",
      "pyrenees-evaluator",
      "pyrenees-benchmark-suite"
    ]
  },
  "paradigms": [
    "offline_rl"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "monitor_metric": {
        "type": "string"
      },
      "preprocess_on_load": {
        "type": "boolean"
      },
      "env_id": {
        "type": "string"
      },
      "offline_only": {
        "type": "boolean"
      },
      "gamma": {
        "type": "number"
      },
      "gae_lambda": {
        "type": "number"
      },
      "reward_type": {
        "type": "string"
      },
      "problem_type": {
        "type": "string"
      },
      "n_actions": {
        "type": "integer"
      },
      "default_plots": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "config_paths": [
    "in/config/env/pyrenees.yaml"
  ]
}
