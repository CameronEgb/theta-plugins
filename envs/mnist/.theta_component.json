{
  "id": "mnist",
  "name": "MNIST Handwritten Digits",
  "kind": "env",
  "version": "1.0.0",
  "description": "Handwritten digits classification benchmark (8x8 mini-MNIST and 28x28 MNIST) supporting supervised, unsupervised, and RL environments.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "tags": [
    "env",
    "mnist",
    "digits",
    "vision",
    "classification",
    "benchmark"
  ],
  "paradigms": [
    "supervised",
    "unsupervised"
  ],
  "target_path": "in/envs/mnist",
  "config_path": "in/config/env/mnist.yaml",
  "config_paths": [
    "in/config/env/mnist.yaml",
    "in/config/env/digits.yaml"
  ],
  "dependencies": {
    "pip": [
      "scikit-learn",
      "numpy",
      "torch"
    ]
  },
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "in/config/env/mnist.yaml": {
        "type": "object",
        "properties": {
          "env_id": {
            "type": "string"
          },
          "environment_source": {
            "type": "string"
          },
          "monitor_metric": {
            "type": "string"
          },
          "dataset_name": {
            "type": "string"
          },
          "obs_dim": {
            "type": "integer"
          },
          "n_actions": {
            "type": "integer"
          },
          "use_sequences": {
            "type": "boolean"
          },
          "val_fraction": {
            "type": "number"
          },
          "batch_size": {
            "type": "integer"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "in/config/env/digits.yaml": {
        "type": "object",
        "properties": {
          "env_id": {
            "type": "string"
          },
          "environment_source": {
            "type": "string"
          },
          "monitor_metric": {
            "type": "string"
          },
          "dataset_name": {
            "type": "string"
          },
          "obs_dim": {
            "type": "integer"
          },
          "n_actions": {
            "type": "integer"
          },
          "use_sequences": {
            "type": "boolean"
          },
          "val_fraction": {
            "type": "number"
          },
          "batch_size": {
            "type": "integer"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
