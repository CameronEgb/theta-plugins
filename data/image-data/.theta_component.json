{
  "id": "image-data",
  "name": "Image Data Module",
  "kind": "datamodule",
  "version": "1.0.0",
  "description": "General-purpose visual observation data module supporting frame stacking, grayscale conversion, spatial resizing, and tensor normalization for image-based RL.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "target_path": "src/usr/data/image_data",
  "config_path": "in/config/data/thetalib/image_data.yaml",
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "online_rl",
    "offline_rl",
    "supervised"
  ],
  "config_paths": [
    "in/config/data/thetalib/image_data.yaml"
  ],
  "suite": "thetalib",
  "hidden": true,
  "parameter_schema": {
    "type": "object",
    "properties": {
      "frame_stack": {
        "type": "integer"
      },
      "grayscale": {
        "type": "boolean"
      },
      "image_size": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "normalize": {
        "type": "boolean"
      },
      "clip_rewards": {
        "type": "boolean"
      },
      "batch_size": {
        "type": "integer"
      }
    }
  }
}
