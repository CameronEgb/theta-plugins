{
  "id": "clinical-timeseries-data",
  "name": "Clinical Timeseries Data Module",
  "kind": "datamodule",
  "version": "1.0.0",
  "description": "Multi-variate clinical EHR/ICU timeseries data loader with windowing, imputation, vital sign normalization, and patient cohort cross-validation.",
  "author": {
    "name": "Theta Clinical Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "target_path": "src/usr/data/clinical_timeseries",
  "config_path": "in/config/data/mimic/clinical_timeseries_data.yaml",
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "supervised",
    "offline_rl"
  ],
  "config_paths": [
    "in/config/data/mimic/clinical_timeseries_data.yaml"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "batch_size": {
        "type": "integer"
      },
      "window_hours": {
        "type": "integer"
      },
      "val_split": {
        "type": "number"
      },
      "test_split": {
        "type": "number"
      },
      "normalize": {
        "type": "boolean"
      },
      "num_workers": {
        "type": "integer"
      },
      "pin_memory": {
        "type": "boolean"
      }
    }
  }
}
