{
  "id": "tabular-data",
  "name": "Tabular Data Module",
  "kind": "datamodule",
  "version": "1.0.0",
  "description": "General tabular dataset loader supporting CSV, NPZ, and NPY files with automated train/val/test splitting and standardization.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "target_path": "src/usr/data/tabular_data",
  "config_path": "in/config/data/thetalib/tabular_data.yaml",
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "supervised",
    "offline_rl",
    "unsupervised"
  ],
  "config_paths": [
    "in/config/data/thetalib/tabular_data.yaml"
  ],
  "suite": "thetalib",
  "hidden": true,
  "parameter_schema": {
    "type": "object",
    "properties": {
      "batch_size": {
        "type": "integer"
      },
      "val_split": {
        "type": "number"
      },
      "test_split": {
        "type": "number"
      },
      "normalize": {
        "type": "boolean"
      },
      "num_workers": {
        "type": "integer"
      },
      "pin_memory": {
        "type": "boolean"
      }
    }
  }
}
