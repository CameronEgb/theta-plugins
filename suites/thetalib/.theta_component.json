{
  "id": "thetalib",
  "name": "ThetaLib Core Foundation Suite",
  "kind": "plugin",
  "version": "1.0.1",
  "description": "Foundational library plugin for Theta-IDE: universal convergence/loss/report figures and core data loaders (image, replay buffer, tabular).",
  "author": {
    "name": "Theta-IDE Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "provides": [
    "standard-figures",
    "image-data",
    "replay-buffer",
    "tabular-data",
    "dnn",
    "mlp",
    "nature_cnn",
    "dueling_resnet"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "online_rl",
    "offline_rl",
    "supervised",
    "unsupervised"
  ],
  "config_paths": [
    "in/config/plot/thetalib/convergence.yaml",
    "in/config/plot/thetalib/losses.yaml",
    "in/config/plot/thetalib/reports.yaml",
    "in/config/data/thetalib/image_data.yaml",
    "in/config/data/thetalib/replay_buffer.yaml",
    "in/config/data/thetalib/tabular_data.yaml",
    "in/config/model/basics/dnn.yaml",
    "in/config/model/basics/mlp.yaml",
    "in/config/model/basics/nature_cnn.yaml",
    "in/config/model/basics/dueling_resnet.yaml"
  ],
  "installed_dirs": [
    "plot/standard_figures",
    "src/usr/data/image_data",
    "src/usr/data/replay_buffer",
    "src/usr/data/tabular_data",
    "src/usr/models/dnn",
    "src/usr/models/mlp",
    "src/usr/models/nature_cnn",
    "src/usr/models/dueling_resnet"
  ]
}
