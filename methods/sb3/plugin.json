{
  "id": "sb3-suite",
  "name": "Stable-Baselines3 Suite",
  "version": "1.0.0",
  "kind": "method",
  "description": "Standard reinforcement learning algorithms (PPO, DQN, A2C, SAC) powered by Stable-Baselines3.",
  "author": "DLR-RM & SB3 Contributors",
  "tags": [
    "rl",
    "baselines",
    "ppo",
    "dqn",
    "sb3"
  ],
  "dependencies": {
    "pip": [
      "stable-baselines3",
      "gymnasium",
      "shimmy"
    ]
  },
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "in/config/agent/sb3/a2c.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "sb3",
              "d3rlpy",
              "cleanrl",
              "custom"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "n_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "ent_coef": {
            "type": "number"
          },
          "vf_coef": {
            "type": "number"
          }
        }
      },
      "in/config/agent/sb3/dqn.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "sb3",
              "d3rlpy",
              "cleanrl",
              "custom"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "buffer_size": {
            "type": "integer"
          },
          "learning_starts": {
            "type": "integer"
          },
          "batch_size": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "train_freq": {
            "type": "integer"
          },
          "target_update_interval": {
            "type": "integer"
          },
          "exploration_fraction": {
            "type": "number"
          }
        }
      },
      "in/config/agent/sb3/ppo.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "sb3",
              "d3rlpy",
              "cleanrl",
              "custom"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "batch_size": {
            "type": "integer"
          },
          "n_steps": {
            "type": "integer"
          },
          "n_epochs": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "clip_range": {
            "type": "number"
          }
        }
      },
      "in/config/agent/sb3/sac.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "sb3",
              "d3rlpy",
              "cleanrl",
              "custom"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "buffer_size": {
            "type": "integer"
          },
          "learning_starts": {
            "type": "integer"
          },
          "batch_size": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "tau": {
            "type": "number"
          },
          "ent_coef": {
            "type": "string"
          }
        }
      }
    }
  },
  "config_paths": [
    "in/config/agent/sb3/a2c.yaml",
    "in/config/agent/sb3/dqn.yaml",
    "in/config/agent/sb3/ppo.yaml",
    "in/config/agent/sb3/sac.yaml"
  ]
}
