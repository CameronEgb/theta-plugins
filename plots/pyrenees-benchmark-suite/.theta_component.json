{
  "id": "pyrenees-benchmark-suite",
  "name": "Pyrenees Benchmark & Hybrid Visualization Suite",
  "kind": "plotter",
  "version": "1.0.0",
  "description": "Pyrenees multi-tier performance reporter, action distribution visualizers, and neural-symbolic blend authority analyzers.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "target_path": "plot/pyrenees_benchmark_suite",
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "offline_rl"
  ],
  "config_paths": [
    "in/config/plot/pyrenees/action_distribution.yaml",
    "in/config/plot/pyrenees/blend_authority.yaml",
    "in/config/plot/pyrenees/blend_handover.yaml",
    "in/config/plot/pyrenees/blend_manifold.yaml",
    "in/config/plot/pyrenees/blend_state_space.yaml",
    "in/config/plot/pyrenees/pyrenees_reporter.yaml"
