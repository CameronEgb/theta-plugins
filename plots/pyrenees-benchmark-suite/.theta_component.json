            }
          },
          "dpi": {
            "type": "integer"
          }
        }
      },
      "in/config/plot/pyrenees/pyrenees_reporter.yaml": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string"
          },
          "include_safety_metrics": {
            "type": "boolean"
          },
          "include_reachability": {
            "type": "boolean"
          }
        }
      }
    }
  }
