              "type": "integer"
            }
          },
          "dpi": {
            "type": "integer"
          }
        }
      },
      "in/config/plot/pyrenees/blend_authority.yaml": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "figsize": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "dpi": {
            "type": "integer"
          }
        }
      },
      "in/config/plot/pyrenees/blend_handover.yaml": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "figsize": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "dpi": {
            "type": "integer"
          }
        }
      },
      "in/config/plot/pyrenees/blend_manifold.yaml": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
